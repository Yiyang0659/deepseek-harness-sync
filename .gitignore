# ==========================================
# DeepSeek Harness (DSH) Git Ignore Configuration
# ==========================================

# 1. 敏感凭据（严禁上传真实 API Key，请使用 .credentials.yaml.example）
.credentials.yaml
.env
*.key
*.pem

# 2. 会话历史、运行缓存与状态（本地临时数据，不建议云端同步）
sessions/
storages/
attachments/
agy-accounts/
agy-link/sessions.json
agy-link/media/
backup-*/
*.bak*
.anonymous-user-id
# 调度器机器本地状态（config.json 入库共享，state.json 各机自持）
git-sync/state.json

# 3. 依赖库目录（体积巨大，通过 package.json/pnpm-lock.yaml 还原）
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 4. 系统与编辑器临时文件
.DS_Store
Thumbs.db
.vscode/
.idea/
*.tmp
*.log
