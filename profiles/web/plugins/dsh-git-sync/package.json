{
  "name": "dsh-git-sync",
  "version": "1.1.0",
  "description": "Real-time Git sync status detection, scheduled daily auto-sync, and one-click Push/Pull buttons in DSH Web UI",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": {
      "default": "./dist/index.js"
    },
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "slots"
      ],
      "platform": "web"
    }
  }
}
