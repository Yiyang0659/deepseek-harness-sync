# ==========================================
# DeepSeek Harness (DSH) 凭据配置模板
# ==========================================
# 使用说明：
# 1. 复制本文件并重命名为 `.credentials.yaml`
# 2. 将下方的占位符替换为你自己的真实 API Key
# 3. 注意：.credentials.yaml 已被 .gitignore 忽略，绝不会被意外上传到 GitHub！

version: 1
refs:
  OPENCODE_API_KEY: your_opencode_api_key_here
  COPILOT_GITHUB_TOKEN: your_company_portal_token_here
  DEEPSEEK_API_KEY: your_deepseek_api_key_here
  ZAI_API_KEY: your_zai_api_key_here
  MIMO_API_KEY: your_mimo_api_key_here
  KIMI_API_KEY: your_kimi_api_key_here
